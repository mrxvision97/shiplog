{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/YOUR_ORG/shiplog/main/plugins/shiplog/skills/shiplog/schema/release.schema.json",
  "title": "Shiplog release",
  "description": "One release: <releases_dir>/<version>.json. validate.py is the source of truth; this schema gives editors autocomplete and basic checks.",
  "type": "object",
  "required": [
    "version",
    "date",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "description": "SemVer without a 'v' prefix. Must match the file name."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD, the day it reached users."
    },
    "summary": {
      "type": "string",
      "maxLength": 120,
      "description": "One-line headline."
    },
    "yanked": {
      "type": "boolean",
      "description": "True if the release was withdrawn."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": [
        "type",
        "title",
        "description",
        "audiences",
        "action_required"
      ],
      "properties": {
        "type": {
          "enum": [
            "added",
            "changed",
            "fixed",
            "deprecated",
            "removed",
            "security"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S",
          "description": "Under 100 chars, from the reader's side."
        },
        "description": {
          "type": "string",
          "pattern": "\\S",
          "description": "Plain language, 20-800 chars. What changed and what the reader will notice."
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Audience ids from .shiplog.json, or [\"everyone\"]."
        },
        "action_required": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "description": "Exactly what to do, in the imperative."
        },
        "action_deadline": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "breaking": {
          "type": "boolean",
          "description": "True forces action_required: true."
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        },
        "internal_notes": {
          "type": "string",
          "description": "Internal only: support talking points."
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Internal only: PRs, tickets, SHAs."
        },
        "_needs_review": {
          "type": "boolean",
          "description": "Set by import_changelog.py. Delete once audiences and actions are confirmed."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action_required": {
                "const": true
              }
            },
            "required": [
              "action_required"
            ]
          },
          "then": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "minLength": 10,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "breaking": {
                "const": true
              }
            },
            "required": [
              "breaking"
            ]
          },
          "then": {
            "properties": {
              "action_required": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "_needs_review": {
                "const": true
              }
            },
            "required": [
              "_needs_review"
            ]
          },
          "else": {
            "properties": {
              "description": {
                "minLength": 20
              }
            }
          }
        }
      ]
    }
  }
}
