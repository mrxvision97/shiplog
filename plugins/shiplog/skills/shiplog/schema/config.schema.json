{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/mrxvision97/shiplog/main/plugins/shiplog/skills/shiplog/schema/config.schema.json",
  "title": "Shiplog config (.shiplog.json)",
  "description": "Either {\"apps\": [...]} or a single app object.",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "apps"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "apps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/app"
          }
        }
      }
    },
    {
      "$ref": "#/definitions/app"
    }
  ],
  "definitions": {
    "app": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Short slug used in --app and default paths."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Directory whose commits belong to this app. Default '.'."
        },
        "tag_prefix": {
          "type": "string",
          "description": "Tags look like <prefix><version>. Default 'v'."
        },
        "releases_dir": {
          "type": "string"
        },
        "output_dir": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "changelog_md": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "lang": {
          "type": "string"
        },
        "project_url": {
          "type": "string"
        },
        "allowed_terms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Words the jargon check should accept, e.g. product names."
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "theme": {
          "type": "object",
          "properties": {
            "accent_color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "logo_url": {
              "type": "string"
            },
            "og_image": {
              "type": "string"
            }
          }
        },
        "page_size": {
          "type": "integer",
          "minimum": 0,
          "description": "Releases on index.html; older ones go to per-year pages. 0 = all on one page."
        },
        "strings": {
          "type": "object",
          "description": "Page labels for translation. See DEFAULT_STRINGS in scripts/_common.py.",
          "properties": {
            "types": {
              "type": "object"
            },
            "months": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 12,
              "maxItems": 12
            },
            "date_format": {
              "type": "string"
            }
          }
        },
        "notify": {
          "type": "object",
          "description": "Release announcements. Holds env var NAMES only, never secrets.",
          "properties": {
            "slack": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "webhook_env": {
                    "type": "string",
                    "description": "Env var holding an incoming webhook URL."
                  },
                  "token_env": {
                    "type": "string",
                    "description": "Env var holding a bot token (xoxb-...). Enables threaded details."
                  },
                  "channel": {
                    "type": "string",
                    "description": "Channel ID for bot-token mode."
                  },
                  "audiences": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "include_internal": {
                    "type": "boolean"
                  },
                  "mention": {
                    "type": "string",
                    "description": "@here, @channel, or <!subteam^ID> for a user group."
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "webhook_env"
                    ]
                  },
                  {
                    "required": [
                      "token_env",
                      "channel"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
